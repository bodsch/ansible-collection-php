#jinja2: trim_blocks: True, lstrip_blocks: True
; {{ ansible_managed }}

[{{ item.name }}]
{% set pools_directives = php_fpm_pool_defaults | default(dict()) | combine(item) %}
{% set listen = pools_directives | bodsch.php.fpm_listener(socket_directory=php_fpm_socket_directory) %}

{% if listen %}
listen = {{ listen }}
{% endif %}

{% for directive, value in pools_directives.items() %}
  {% if directive not in ["name", "listen", "listen_host", "listen_port"] %}
    {% if value is mapping %}
      {% for key, value2 in value.items() %}
{{ directive }}[{{ key }}] = {{ value2 }}
      {% endfor %}
    {% else %}
{{ directive }} = {{ value }}
    {% endif %}
  {% endif %}
{% endfor %}
